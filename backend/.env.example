DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=0.0.0.0,localhost,127.0.0.1,localhost:3000
REMONLINE_API_KEY =
REMONLINE_BRANCH_PROD_ID  =
PRICE_ID_PROD =
BONUS_ID=
DELETE_ORDER_STATUS_ID= #Used for merge orders
CATEGORIES_WHITELIST_IDS=
REMONLINE_ORDER_TYPE_ID=
REMONLINE_TOGETHERBUY_CUSTOM_FIELD_ID="f9640676"
LOCAL=True
# Fallback-креды Monobank (используются, если не заданы пары *_TEST / *_PROD ниже).
MONOBANK_TOKEN=
MONOBANK_WEBHOOK_KEY= # https://api.monobank.ua/api/merchant/pubkey

# Креды по режимам. Активный режим выбирается НЕ здесь, а в админке:
# /admin/payments/paymentsettings/ (модель payments.PaymentSettings).
# Токены обязаны различаться — иначе переключение режима ничего не меняет
# и бойовий режим будет заблокирован валидацией.
# Webhook key берётся у своего мерчанта: GET /api/merchant/pubkey с его токеном.
# После правки .env: docker compose up -d --force-recreate backend celery
MONOBANK_TOKEN_TEST=
MONOBANK_WEBHOOK_KEY_TEST=
MONOBANK_TOKEN_PROD=
MONOBANK_WEBHOOK_KEY_PROD=

# Google Pay gatewayMerchantId по режимам (не секрет, отдаётся фронту
# через /api/v2/payments/config/).
GOOGLE_PAY_MERCHANT_ID_TEST=
GOOGLE_PAY_MERCHANT_ID_PROD=
DOMAIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
REDIS_URL=redis://redis:6379/2

# Почта: Brevo, отправка от noreply@airbagad.com.
# Домен подтверждён в Brevo по DKIM (CNAME brevo1/brevo2._domainkey). Отдельная
# SPF-запись не нужна: Return-Path на домене Brevo, DMARC проходит по DKIM.
#
# По умолчанию используется HTTP API (EMAIL_BACKEND=core.mail.brevo.BrevoAPIEmailBackend
# зашит в settings.py) — он ходит по 443 и не зависит от блокировки почтовых портов.
# Ключ берётся в панели: SMTP & API -> API Keys, значение вида xkeysib-...
BREVO_API_KEY=
#
# Запасной путь — SMTP. Включается раскомментированием EMAIL_BACKEND.
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD — из SMTP & API -> SMTP: логин вида
# xxxxxxxxx@smtp-brevo.com и SMTP key (не пароль от аккаунта Brevo).
# Штатный порт 587 (EMAIL_USE_TLS=True); если он закрыт, есть 465 (EMAIL_USE_SSL=True,
# EMAIL_USE_TLS=False) и 2525.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@airbagad.com

# Восстановление пароля.
# FRONTEND_URL — публичный адрес фронтенда, из него строится ссылка в письме
# (DOMAIN выше указывает на API и для этого не годится).
# PASSWORD_RESET_EMAIL_ASYNC=False — слать письмо синхронно, минуя Celery.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_EMAIL_ASYNC=True