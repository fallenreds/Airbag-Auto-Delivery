# Переменные для подстановки в docker-compose.yml.
#
# Файл `.env` рядом с docker-compose.yml compose читает автоматически. Локально
# он не нужен: дефолты в compose рассчитаны на разработку. На сервере `.env`
# обязателен — там значения боевые.
#
# Скопируйте этот файл в `.env` только если нужно переопределить дефолт.

# Адрес API, который вшивается во фронтенд на этапе сборки.
# Дефолт в compose — http://localhost:8000/api/v2 (локальный бэкенд).
# На проде: https://api.airbagad.com/api/v2
#
# Раньше боевой адрес был дефолтом, и `docker compose up` на машине
# разработчика поднимал фронт, ходящий в прод: тесты заводили там настоящие
# заказы.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v2
